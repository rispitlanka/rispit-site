 "notes": {
  "note-blog": {
   "fill": "orange",
   "text": "Article titles, excerpts and covers are placeholders. On the live site, pull the 3 latest posts from your blog automatically.",
   "w": 320,
   "x": 1540,
   "y": 10542
  },
  "note-case": {
   "fill": "orange",
   "text": "Template for every case study: Hero (photo + CTA) + project facts → Background / Objective / Solution → Screens (mixed sizes) → Results → Client quote → Tech used → Next case → Booking → Footer. Results in [brackets] must be filled with real numbers.",
   "w": 320,
   "x": 7040,
   "y": 0
  },
  "note-clients": {
   "fill": "orange",
   "text": "Client names and logos are placeholders. Swap in real client logos (SVG or PNG, one colour) before launch. The rows pause on hover.",
   "w": 320,
   "x": 1540,
   "y": 4332
  },
  "note-consult": {
   "fill": "orange",
   "text": "Days and times are clickable in Play. On the live site, connect the booking widget to Calendly or Cal.com. Replace [Your Name] with your name. All 'Let's Talk' buttons should scroll here.",
   "w": 320,
   "x": 1540,
   "y": 7177
  },
  "note-contact": {
   "fill": "orange",
   "text": "Contact: tabs switch between Book a call and Send a message in Play. Connect the calendar to Calendly or Cal.com and the form to your email. Replace the [bracketed] email, WhatsApp and reply time.",
   "w": 320,
   "x": 17680,
   "y": 1900
  },
  "note-emails": {
   "fill": "orange",
   "text": "Emails are 600px wide, the standard for inboxes. Words in [brackets] are filled in automatically by your booking and newsletter tools. The Christmas strip can be removed after the offer ends.",
   "w": 320,
   "x": 22560,
   "y": 2160
  },
  "note-legal": {
   "fill": "orange",
   "text": "Legal text is a plain-English starting draft, not legal advice. Fill the [brackets] and have a lawyer review both pages for your country before launch.",
   "w": 320,
   "x": 15680,
   "y": 0
  },
  "note-portfolio": {
   "fill": "orange",
   "text": "Filters work in Play. Project names, images and descriptions are placeholders: add each real project with its cover image. Every card links to its case study page.",
   "w": 320,
   "x": 12140,
   "y": 0
  },
  "note-products": {
   "fill": "orange",
   "text": "Product names, descriptions and preview screens are placeholders. Replace each preview with a real screenshot of the product, and link each 'View case study' button to its case study page.",
   "w": 320,
   "x": 1540,
   "y": 5292
  },
  "note-sticky": {
   "fill": "orange",
   "text": "Sticky navbar: floats 16px from the top of the window and stays visible while the page scrolls, sitting above the hero and every section.",
   "w": 320,
   "x": 1540,
   "y": 0
  },
  "note-svc-mobile": {
   "fill": "orange",
   "text": "Template for every service page: Hero → What's included → How it works → Featured project → Stack → FAQ → Booking → Footer. FAQ opens/closes in Play. Navbar shows 'Services' as active.",
   "w": 320,
   "x": 5060,
   "y": 0
  },
  "note-tech": {
   "fill": "orange",
   "text": "Dashed squares are logo slots: drop in each tool's official logo (SVG from its brand/press page). Rows scroll in opposite directions and pause on hover; chips lift on hover. Edit the tool list to match your real stack.",
   "w": 320,
   "x": 1540,
   "y": 11782
  },
  "note-testimonials": {
   "fill": "orange",
   "text": "Final: mix of video story cards and text cards. Swap any card type to match what each client gives you. Photos, videos, names and quotes are placeholders: use real ones (with permission).",
   "w": 320,
   "x": 1540,
   "y": 9262
  },
